@use '../../helpers' as *;

.ranking {
  &__row {
    display: grid;
    grid-template-columns: minmax(260px, 3fr) repeat(7, minmax(48px, 1fr));
    align-items: center;
    column-gap: 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--color-gray-20); 

    &:last-child {
      border-bottom: none;
    }

    &--head {
      padding-top: 0;
      border-bottom: none; 
      font-weight: 700;

      .ranking__cell {

      }
    }
  }

  &__cell {
    @include fluid-text(16, 14);

    text-align: center;

    &--club {
      display: flex;
      align-items: center;
      column-gap: 16px;
      justify-self: start;  
    }
  }

  &__row--head &__cell--club {
    text-underline-offset: 4px;
    font-weight: 500;
  }

  &__position {
    @include fluid-text(13, 10);

    width: 16px;
    font-weight: 700;
    color: var(--color-dark);
  }

  &__logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  &__name {
    @include fluid-text(13, 10);

    font-weight: 700;
    white-space: nowrap;
  }
}

